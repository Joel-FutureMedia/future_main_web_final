---
import Layout from '../layouts/Layout.astro';
import { offerRow } from '../lib/latest-offers.mjs';
const logo = "/assets/Logos/fm_web_scroll_promo.png";
const person = "/assets/Digital/11_PromoBasket/Gemini_Generated_Image_165gx165gx165gx1.webp";
const landingPerson = "/assets/outdoor/Promobasket_Landing_Hero.png";
const landingBg = "/assets/landingpage_image.webp";
const copy = "Put your brand on display at outdoor events, exhibitions and promotions across Namibia. Help people find your stand with branded banners and gazebos, make your team easy to spot in matching apparel, and give visitors something useful to take home with branded stationery and promotional items.";
const offers = [
  offerRow("fresh-fm", "Fresh Fridays Outside", logo),
  offerRow("fresh-fm", "Fresh Fridays", logo),
  offerRow("radiowave", "Sugar Radio Show", logo),
  offerRow("radiowave", "Grand Prix Pulse", logo),
  offerRow("radiowave", "The Gig Guide", logo)
];
const features = [
  {
    id: "gazebos",
    tag: "Outdoor",
    title: "Gazebos",
    body: "Branded gazebos and outdoor structures for activations, launches and festival presence.",
    bg: "/assets/Digital/11_PromoBasket/promobasket-gazebos.jpg"
  },
  {
    id: "apparel",
    tag: "Promotions",
    title: "Apparel",
    body: "Event wear, staff kits and merchandise that keep your brand moving with the crowd.",
    bg: "/assets/Digital/11_PromoBasket/promobasket-apparel.jpg"
  },
  {
    id: "stationery",
    tag: "Promotions",
    title: "Stationery",
    body: "Notebooks, folders and desk kits for conferences, pitch rooms and client gifts.",
    bg: "/assets/Digital/11_PromoBasket/promobasket-stationery.jpg"
  }
];
---
<Layout title="Outdoor & Promotions | FutureMedia" bodyClass="brands digital outdoor" preload={landingPerson}>
<div class="branddeck" style="--n:2">
<div class="brandstage">
<section class="slide bintro on" id="network">
  <div class="bgimg" style={`background-image:url(${landingBg})`}></div>
  <div class="introcopy">
    <p class="eyebrow seo-only">Outdoor &amp; Promotions</p>
    <h1>Promobasket</h1>
    <p class="page-tag">Where good brands go to look great.</p>
    <p>Put your brand on display at outdoor events, exhibitions and promotions across Namibia. Help people find your stand with branded banners and gazebos, make your team easy to spot in matching apparel, and give visitors something useful to take home with branded stationery and promotional items.</p>
  </div>
  <div class="intro-person-wrap">
    <img class="intro-person" src={landingPerson} alt="" decoding="async" fetchpriority="high">
  </div>
  <a class="scroll-cue" href="#promobasket">
    <span class="scroll-arrow" aria-hidden="true"></span>
    <span>Scroll down to explore PromoBasket</span>
  </a>
</section>

<section class="slide brand" id="promobasket" style="--c:#8A2040;--panel:#D42A42">
  <img class="personality" alt="" decoding="async" data-src={person}>
  <div class="bwrap">
    <div class="bmain">
      <img class="blogo" decoding="async" src={logo} alt="PromoBasket">
      <p>{copy}</p>
    </div>
    <div class="panel" data-offers={JSON.stringify(offers)}><div class="top"><h2>Latest Offers</h2></div><div class="rows"></div></div>
  </div>
</section>
</div>
</div>

<nav class="rail" aria-label="Outdoor and promotions">
  <a href="#promobasket" style="--c:#8A2040" aria-label="PromoBasket"></a>
</nav>

<section class="wrap upc outdoor-features" id="offerings">
  <h2>How we make your brand visible</h2>
  <div class="cards">
    {features.map(item => (
      <article class="card" id={item.id} data-bg={`url(${item.bg})`}>
        <span class="tag">{item.tag}</span>
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </article>
    ))}
  </div>
  <div class="outdoor-enquire">
    <a class="cta-pill" href="/contact.html">Enquire</a>
  </div>
</section>

<Fragment slot="scripts">
<script is:inline src="/js/brands.js"></script>
</Fragment>
</Layout>
