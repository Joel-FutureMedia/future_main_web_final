---
import Layout from '../layouts/Layout.astro';
const logo = "/assets/Logos/fm_web_scroll_promo.png";
const person = "/assets/Digital/11_PromoBasket/Gemini_Generated_Image_165gx165gx165gx1.png";
const copy = "PromoBasket turns brands into tangible moments - gazebos, apparel, stationery and activation kits that keep your name in the room long after the campaign ends. From concept to print and install, we kit out outdoor and promotional work that looks as sharp as it performs.";
const offers = [
  ["Branded Gazebos", "Own the activation with branded outdoor structures.", "/contact.html", logo, "contain"],
  ["Apparel & Merch", "Staff kits, giveaways and event wear that travel with your brand.", "/contact.html", logo, "contain"],
  ["Stationery Sets", "Folders, notebooks and desk kits for conferences and launches.", "/contact.html", logo, "contain"],
  ["Activation Kits", "Full PromoBasket bundles for roadshows and brand days.", "/contact.html", logo, "contain"],
  ["Talk to sales", "Plan outdoor and promotional work with the Future Media team.", "/contact.html", logo, "contain"]
];
const features = [
  {
    id: "gazebos",
    tag: "Outdoor",
    title: "Gazebos",
    body: "Branded gazebos and outdoor structures for activations, launches and festival presence.",
    href: "/contact.html",
    bg: "/assets/Digital/11_PromoBasket/promobasket-gazebos.jpg"
  },
  {
    id: "apparel",
    tag: "Promotions",
    title: "Apparel",
    body: "Event wear, staff kits and merchandise that keep your brand moving with the crowd.",
    href: "/contact.html",
    bg: "/assets/Digital/11_PromoBasket/promobasket-apparel.jpg"
  },
  {
    id: "stationery",
    tag: "Promotions",
    title: "Stationery",
    body: "Notebooks, folders and desk kits for conferences, pitch rooms and client gifts.",
    href: "/contact.html",
    bg: "/assets/Digital/11_PromoBasket/promobasket-stationery.jpg"
  }
];
---
<Layout title="Outdoor & Promotions – FutureMedia" bodyClass="brands digital outdoor" preload={person}>
<div class="branddeck" style="--n:2">
<div class="brandstage">
<section class="slide bintro on" id="network">
  <div class="bgimg" style="background-image:url(/assets/landingpage_image.webp)"></div>
  <div class="introcopy">
    <p class="eyebrow">Outdoor &amp; Promotions</p>
    <h1>PromoBasket. Brands you can hold.</h1>
    <p>Scroll to explore PromoBasket — then see gazebos, apparel and stationery built for real activations.</p>
  </div>
  <div class="intro-person-wrap">
    <img class="intro-person" src={person} alt="" decoding="async">
  </div>
  <a class="scroll-cue" href="#promobasket">
    <span class="scroll-arrow" aria-hidden="true"></span>
    <span>Scroll down to explore PromoBasket</span>
  </a>
</section>

<section class="slide brand" id="promobasket" style="--c:#8A2040;--panel:#D42A42">
  <img class="personality" src={person} alt="">
  <div class="bwrap">
    <div class="bmain">
      <img class="blogo" decoding="async" src={logo} alt="PromoBasket">
      <p>{copy}</p>
    </div>
    <div class="panel" data-offers={JSON.stringify(offers)}><div class="top"><h2>Latest Offers</h2></div><div class="rows"></div></div>
  </div>
</section>
</div>
</div>

<nav class="rail" aria-label="Outdoor and promotions">
  <a href="#promobasket" style="--c:#8A2040" aria-label="PromoBasket"></a>
</nav>

<section class="wrap upc outdoor-features" id="offerings">
  <h2>What we make</h2>
  <div class="cards">
    {features.map(item => (
      <a class="card" id={item.id} href={item.href} data-bg={`url(${item.bg})`}>
        <span class="tag">{item.tag}</span>
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </a>
    ))}
  </div>
</section>

<Fragment slot="scripts">
<script is:inline src="/js/brands.js"></script>
</Fragment>
</Layout>
