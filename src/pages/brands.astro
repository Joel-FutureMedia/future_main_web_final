---
import Layout from '../layouts/Layout.astro';
import { brandRows, offerRow } from '../lib/latest-offers.mjs';
const root = "/assets/Broadcast%20Brands";
const learnLogo = "/assets/Brandlogos/learn%20on%20one.webp";
const brands = [
  {
    id: "oneafrica", color: "#f15024", name: "One Africa", logo: "/assets/Brandlogos/oneafrica.webp",
    bg: `${root}/One%20Africa/FM_Brands_One_BG.jpg`,
    person: `${root}/One%20Africa/FM_Brands_One_Personality.webp`,
    map: `${root}/One%20Africa/FM_Brands_One_Map.svg`,
    copy: "One Africa Television brings Namibians news, drama, sport and entertainment on DStv and local free-to-air platforms. Stories told in a voice audiences recognise as their own.",
    f: 46, m: 54, lsm: "6 to 10",
    offers: brandRows("oneafrica", 5, "/assets/Brandlogos/oneafrica.webp")
  },
  {
    id: "99fm", color: "#e30a7f", name: "99FM", logo: "/assets/Brandlogos/99fm.webp",
    bg: `${root}/99FM/FM_Brands_99_BG.webp`,
    person: `${root}/99FM/FM_Brands_99_Personality.webp`,
    map: `${root}/99FM/FM_Brands_99_Map.svg`,
    copy: "99FM reaches people driven by economic, social, and personal advancement, with uplifting talk and Hip-Hop, Afro, and RnB.",
    f: 48, m: 52, lsm: "7 to 10",
    offers: brandRows("99fm", 5, "/assets/Brandlogos/99fm.webp")
  },
  {
    id: "nova", color: "#1e8dc5", name: "Nova FM", logo: "/assets/Brandlogos/novafm.webp",
    bg: `${root}/Nova/FM_Brands_Noova_BG.jpeg`,
    person: `${root}/Nova/FM_Brands_Nova_Personality.webp`,
    map: `${root}/Nova/FM_Brands_Nova_Map.svg`,
    copy: "Nova FM is pop, R&B and lifestyle talk for young professionals. A strong home for fashion, finance, tech and entertainment brands.",
    f: 55, m: 45, lsm: "6 to 10",
    offers: brandRows("nova", 5, "/assets/Brandlogos/novafm.webp")
  },
  {
    id: "fresh", color: "#ee3030", name: "Fresh FM", logo: "/assets/Brandlogos/freshfm.webp",
    bg: `${root}/Fresh/FM_Brands_Fresh_BG.jpeg`,
    person: `${root}/Fresh/FM_Brands_Fresh_Personality.webp`,
    map: `${root}/Fresh/FM_Brands_Fresh_Map.svg`,
    copy: "Fresh FM plays the biggest hits, Afro house and party energy for a young, social audience. Built for beverages, retail, mobile and events.",
    f: 45, m: 55, lsm: "5 to 9",
    offers: brandRows("fresh-fm", 5, "/assets/Brandlogos/freshfm.webp")
  },
  {
    id: "omulunga", color: "#0c6633", name: "Omulunga Radio", logo: "/assets/Brandlogos/omulungar.webp",
    bg: `${root}/Omulunga/FM_Brands_Omulunga_BG.jpeg`,
    person: `${root}/Omulunga/FM_Brands_Omulunga_Personality.webp`,
    map: `${root}/Omulunga/FM_Brands_Omulunga_Map.svg`,
    copy: "Omulunga Radio broadcasts in Oshiwambo, connecting families across the northern regions with local music, community news and cultural stories.",
    f: 51, m: 49, lsm: "4 to 8",
    offers: brandRows("omulunga", 5, "/assets/Brandlogos/omulungar.webp")
  },
  {
    id: "radiowave", color: "#143443", name: "Radio Wave", logo: "/assets/Brandlogos/radiowave.webp",
    bg: `${root}/Radiowave/FM_Brands_Wave_BG.jpeg`,
    person: `${root}/Radiowave/FM_Brands_Wave_Personality.webp`,
    map: `${root}/Radiowave/FM_Brands_Wave_Map.svg`,
    copy: "Radio Wave plays classic and contemporary favourites for working adults and decision makers through the workday.",
    f: 49, m: 51, lsm: "7 to 10",
    offers: brandRows("radiowave", 5, "/assets/Brandlogos/radiowave.webp")
  },
  {
    id: "learnonone", color: "#00843d", name: "Learn on One", logo: "/assets/Brandlogos/learn%20on%20one.webp",
    bg: `${root}/LearnOnOne/FM_Brands_LOO_BG.jpg`,
    person: `${root}/LearnOnOne/FM_Brands_LOO_Personality.webp`,
    map: `${root}/LearnOnOne/FM_Brands_LOO_Map.svg`,
    copy: "Learn on One broadcasts free curriculum-based lessons for Pre-Primary, Primary and Secondary learners on One Africa and on-demand online. Endorsed by the Ministry of Education, Arts and Culture.",
    f: 52, m: 48, lsm: "4 to 8",
    offers: [
      offerRow("oneafrica", "Akili & Me", learnLogo),
      offerRow("oneafrica", "Ubongo Kids", learnLogo),
      offerRow("oneafrica", "Kiki & Nuna", learnLogo),
      offerRow("oneafrica", "Cartunes", learnLogo),
      offerRow("oneafrica", "NamFlix", learnLogo)
    ]
  }
];
---
<Layout title="The network | Broadcast Brands | FutureMedia" fonts="display" bodyClass="brands" preload={`${root}/FM_Brands_Intro_Personality.webp`}>
<div class="branddeck" style="--n:8">
<div class="brandstage">
<section class="slide bintro on" id="network">
  <div class="bgimg" style="background-image:url(/assets/landingpage_image.webp)"></div>
  <div class="introcopy">
    <p class="eyebrow seo-only">The network</p>
    <h1>Six Broadcast Brands.<br>One Powerful Network.</h1>
    <p>From the morning drive to the family living room, our broadcast network takes your brand into everyday life across Namibia. Five radio stations and one television brand connect you with people from all walks of life.</p>
  </div>
  <div class="intro-person-wrap">
    <img class="intro-person" src={`${root}/FM_Brands_Intro_Personality.webp`} alt="" decoding="async" fetchpriority="high">
  </div>
  <a class="scroll-cue" href={`#${brands[0].id}`}>
    <span class="scroll-arrow" aria-hidden="true"></span>
    <span>Scroll down to explore our broadcast brands</span>
  </a>
</section>

{brands.map(brand => (
<section class="slide brand" id={brand.id} style={`--c:${brand.color}`}>
  <div class="bgimg" data-bg={brand.bg}></div>
  <img class="personality" alt="" decoding="async" data-src={brand.person}>
  <div class="bwrap">
    <div class="bmain">
      <img class="blogo" decoding="async" src={brand.logo} alt={brand.name}>
      <p>{brand.copy}</p>
      <div class="bstats">
        <div class="stat"><img class="bmap" src={brand.map} alt={`${brand.name} coverage`}><small>Reach</small></div>
        <div class="stat"><div class="gender" data-f={brand.f} data-m={brand.m}></div></div>
        <div class="stat"><span class="lsm">{brand.lsm}</span><small>LSM</small></div>
      </div>
    </div>
    <div class="panel" data-offers={JSON.stringify(brand.offers)}><div class="top"><h2>Latest Offers</h2></div><div class="rows"></div></div>
  </div>
</section>
))}
</div>
</div>
<nav class="rail" aria-label="Brands">
  {brands.map(brand => <a href={`#${brand.id}`} style={`--c:${brand.color}`} aria-label={brand.name}></a>)}
</nav>
<Fragment slot="scripts">
<script is:inline src="/js/brands.js"></script>
</Fragment>
</Layout>
