---
import Layout from '../layouts/Layout.astro';

type Offer = {
  title: string;
  body: string;
  href: string;
  image: string;
  fit?: "contain" | "cover";
  category: "broadcast" | "digital" | "outdoor" | "promotion" | "conference";
};

const offers: Offer[] = [
  { category: "broadcast", title: "99FM Offer", body: "Drive-time packages on Namibia’s boldest station.", href: "/brands.html#99fm", image: "/assets/Brandlogos/99fm.webp", fit: "contain" },
  { category: "broadcast", title: "Fresh FM Weekend", body: "Own the Friday kick-off with live reads.", href: "/brands.html#fresh", image: "/assets/Brandlogos/freshfm.webp", fit: "contain" },
  { category: "broadcast", title: "One Africa Prime", body: "Be seen during evening news and lifestyle shows.", href: "/brands.html#oneafrica", image: "/assets/Brandlogos/oneafrica.webp", fit: "contain" },
  { category: "broadcast", title: "Nova Morning Show", body: "Own the daily wake-up call for young professionals.", href: "/brands.html#nova", image: "/assets/Brandlogos/novafm.webp", fit: "contain" },
  { category: "broadcast", title: "Omulunga Market Day", body: "Retail promotion packages across northern Namibia.", href: "/brands.html#omulunga", image: "/assets/Brandlogos/omulungar.webp", fit: "contain" },
  { category: "broadcast", title: "Radio Wave Workday", body: "Sponsor the 9 to 5 playlist for decision makers.", href: "/brands.html#radiowave", image: "/assets/Brandlogos/radiowave.webp", fit: "contain" },

  { category: "digital", title: "Specials.na", body: "Put your deals where shoppers already look.", href: "/digital.html#specials", image: "/assets/Logos/fm_web_scroll_specials.png", fit: "contain" },
  { category: "digital", title: "Shop Beat Demo", body: "See in-store audio change the room.", href: "/shopbeat.html", image: "/assets/Logos/fm_web_scroll_shopbeat.png", fit: "contain" },
  { category: "digital", title: "Entryfy Competitions", body: "AI competitions with WhatsApp entries and clean data.", href: "/digital.html#entryfy", image: "/assets/Logos/fm_web_scroll_entryfy.png", fit: "contain" },
  { category: "digital", title: "Property News", body: "Reach buyers, agents and developers where they browse.", href: "/digital.html#propertynews", image: "/assets/Logos/fm_web_scroll_propnews.png", fit: "contain" },

  { category: "outdoor", title: "PromoBasket Gazebos", body: "Branded outdoor structures for activations and launches.", href: "/outdoor.html#gazebos", image: "/assets/Logos/fm_web_scroll_promo.png", fit: "contain" },
  { category: "outdoor", title: "Apparel & Merch", body: "Event wear and staff kits that travel with your brand.", href: "/outdoor.html#apparel", image: "/assets/Logos/fm_web_scroll_promo.png", fit: "contain" },
  { category: "outdoor", title: "Stationery Sets", body: "Notebooks, folders and desk kits for conferences.", href: "/outdoor.html#stationery", image: "/assets/Logos/fm_web_scroll_promo.png", fit: "contain" },
  { category: "outdoor", title: "Activation Kits", body: "Full PromoBasket bundles for roadshows and brand days.", href: "/outdoor.html#promobasket", image: "/assets/Logos/fm_web_scroll_promo.png", fit: "contain" },

  { category: "conference", title: "Conference Offer", body: "Sponsor Future of Business and meet the room.", href: "/conferences.html", image: "/assets/conference/slide1.webp", fit: "cover" },
  { category: "conference", title: "Buy a Ticket", body: "Reserve your seat at the next Future Media event.", href: "/conferences.html", image: "/assets/conference/slide2.webp", fit: "cover" },
  { category: "conference", title: "Book a Table", body: "Bring your team or host your clients.", href: "/conferences.html", image: "/assets/conference/slide3.webp", fit: "cover" },

  { category: "promotion", title: "Media Audit", body: "A free read on where your brand should be.", href: "/media-audit.html", image: "/assets/landingpage_image.webp", fit: "cover" },
  { category: "promotion", title: "Newsletter Offer", body: "Weekly media notes, straight to your inbox.", href: "/news.html", image: "/assets/news/news01.webp", fit: "cover" },
  { category: "promotion", title: "Audio Production", body: "Broadcast-ready radio spots under one roof.", href: "/advertise.html#audio", image: "/assets/Brandlogos/99fm.webp", fit: "contain" },
  { category: "promotion", title: "Video for One Africa", body: "Graphic ads, motion and full advert shoots.", href: "/advertise.html#video", image: "/assets/Brandlogos/oneafrica.webp", fit: "contain" }
];

const categories = [
  { id: "all", label: "All offers" },
  { id: "broadcast", label: "Broadcast" },
  { id: "digital", label: "Digital" },
  { id: "outdoor", label: "Outdoor" },
  { id: "promotion", label: "Promotion" },
  { id: "conference", label: "Conference" }
] as const;

const byCategory = (id: string) =>
  id === "all" ? offers : offers.filter(item => item.category === id);
---
<Layout title="Latest Offers – FutureMedia" bodyClass="offers-page">
<section class="offers-hero">
  <div class="offers-hero-copy">
    <p class="eyebrow">Advertise</p>
    <h1>Latest Offers</h1>
    <p>Packages across broadcast, digital, outdoor, promotions and conferences - browse by category or jump straight to a brand.</p>
  </div>
</section>

<main class="offers-page-main">
  <div class="offers-filters" role="tablist" aria-label="Offer categories">
    {categories.map((cat, index) => (
      <button
        type="button"
        class:list={["offers-filter", { on: index === 0 }]}
        data-filter={cat.id}
        role="tab"
        aria-selected={index === 0 ? "true" : "false"}
      >{cat.label}</button>
    ))}
  </div>

  {categories.map(cat => (
    <section class="offers-section" data-category={cat.id} hidden={cat.id !== "all"}>
      {cat.id !== "all" ? <h2>{cat.label}</h2> : null}
      <div class="offers-grid">
        {byCategory(cat.id).map(item => (
          <a class="offers-card" href={item.href} data-category={item.category}>
            <span class={`offers-thumb ${item.fit || "cover"}`}>
              <img src={item.image} alt="" decoding="async" loading="lazy">
            </span>
            <span class="offers-tag">{item.category}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </a>
        ))}
      </div>
    </section>
  ))}
</main>

<Fragment slot="scripts">
<script is:inline>
(() => {
  const filters = [...document.querySelectorAll(".offers-filter")];
  const sections = [...document.querySelectorAll(".offers-section")];
  const paint = id => {
    filters.forEach(btn => {
      const on = btn.dataset.filter === id;
      btn.classList.toggle("on", on);
      btn.setAttribute("aria-selected", on ? "true" : "false");
    });
    sections.forEach(section => {
      section.hidden = section.dataset.category !== id;
    });
  };
  filters.forEach(btn => btn.addEventListener("click", () => paint(btn.dataset.filter)));
})();
</script>
</Fragment>
</Layout>
