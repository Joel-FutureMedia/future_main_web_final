---
import Layout from '../layouts/Layout.astro';
---
<Layout title="News – FutureMedia" bodyClass="news-page">
<section class="wrap news-hero">
  <p class="eyebrow">Newsroom</p>
  <h1>News &amp; stories</h1>
  <p class="news-lead">Updates from Future Media - campaigns, conferences and the brands that keep Namibia connected.</p>
</section>
<section class="wrap">
  <div class="cards" id="newsGrid"><p>Loading news…</p></div>
</section>
<section class="wrap upc">
  <h2>Upcoming Events</h2>
  <div class="cards" id="eventGrid"><p>Loading events…</p></div>
</section>
</Layout>
