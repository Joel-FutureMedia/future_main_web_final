---
import Layout from '../layouts/Layout.astro';
import { offerRow } from '../lib/latest-offers.mjs';
const logosRoot = "/assets/Logos";
const brands = [
  {
    id: "specials", color: "#7A2D86", panel: "#8F9C4A", name: "specials.na",
    logo: `${logosRoot}/fm_web_scroll_specials.png`,
    person: "/assets/Digital/7_Specials/FM_Brands_Specials_Hero.webp",
    copy: "Promote your offers on Specials.na and reach shoppers looking for deals across Namibia.",
    offers: [
      offerRow("fresh-fm", "What’s for Lunch?", `${logosRoot}/fm_web_scroll_specials.png`),
      offerRow("fresh-fm", "Too Good To Be True", `${logosRoot}/fm_web_scroll_specials.png`),
      offerRow("99fm", "Sweet Escape", `${logosRoot}/fm_web_scroll_specials.png`),
      offerRow("fresh-fm", "The Joybox", `${logosRoot}/fm_web_scroll_specials.png`),
      offerRow("fresh-fm", "Quiz Master", `${logosRoot}/fm_web_scroll_specials.png`)
    ]
  },
  {
    id: "shopbeat", color: "#8A348C", panel: "#7EB8CC", name: "Shop Beat",
    logo: `${logosRoot}/fm_web_scroll_shopbeat.png`,
    person: "/assets/Digital/8_Shop%20Beat/FM_Brands_Shopbeat_Hero.webp",
    copy: "Reach shoppers in store with ShopBeat, putting your brand in the aisle where buying decisions happen.",
    offers: [
      offerRow("fresh-fm", "Fresh Fridays", `${logosRoot}/fm_web_scroll_shopbeat.png`),
      offerRow("omulunga", "Taste of Home", `${logosRoot}/fm_web_scroll_shopbeat.png`),
      offerRow("fresh-fm", "The Fresh Hitlist", `${logosRoot}/fm_web_scroll_shopbeat.png`),
      offerRow("radiowave", "Millennial Mixtape", `${logosRoot}/fm_web_scroll_shopbeat.png`),
      offerRow("radiowave", "Sugar Radio Show", `${logosRoot}/fm_web_scroll_shopbeat.png`)
    ]
  },
  {
    id: "entryfy", color: "#241548", panel: "#E39B78", name: "Entryfy",
    logo: `${logosRoot}/fm_web_scroll_entryfy.png`,
    person: "/assets/Digital/9_Entryfy/FM_Brands_Entryfy_Hero.webp",
    copy: "Invite customers to enter competitions through Entryfy and grow engagement around your brand.",
    offers: [
      offerRow("radiowave", "Pop Quiz", `${logosRoot}/fm_web_scroll_entryfy.png`),
      offerRow("fresh-fm", "Quiz Master", `${logosRoot}/fm_web_scroll_entryfy.png`),
      offerRow("fresh-fm", "Who Said That?", `${logosRoot}/fm_web_scroll_entryfy.png`),
      offerRow("fresh-fm", "Mystery Clip", `${logosRoot}/fm_web_scroll_entryfy.png`),
      offerRow("99fm", "Lost and Found", `${logosRoot}/fm_web_scroll_entryfy.png`)
    ]
  },
  {
    id: "propertynews", color: "#9C2D58", panel: "#E23B3B", name: "Property News",
    logo: `${logosRoot}/fm_web_scroll_propnews.png`,
    person: "/assets/Digital/10_Property%20News/PropertyNews%20Namibia%20Laptop%20Mockup.webp",
    copy: "Connect with people exploring Namibia’s property market through Property News Online.",
    offers: [
      offerRow("fresh-fm", "Real Estate Breakfast", `${logosRoot}/fm_web_scroll_propnews.png`),
      offerRow("fresh-fm", "The Business Corner", `${logosRoot}/fm_web_scroll_propnews.png`),
      offerRow("nova", "Sakegesprekke (Business Conversations)", `${logosRoot}/fm_web_scroll_propnews.png`),
      offerRow("99fm", "The Pitch", `${logosRoot}/fm_web_scroll_propnews.png`),
      offerRow("99fm", "Wealth Talks", `${logosRoot}/fm_web_scroll_propnews.png`)
    ]
  }
];
---
<Layout title="The network | Digital Brands | FutureMedia" bodyClass="brands digital" preload="/assets/Digital/FM_Brands_Digital_Intro_Personality.webp">
<div class="branddeck" style="--n:5">
<div class="brandstage">
<section class="slide bintro on" id="network">
  <div class="bgimg" style="background-image:url(/assets/landingpage_image.webp)"></div>
  <div class="introcopy">
    <p class="eyebrow seo-only">The network</p>
    <h1>Four Digital Brands<br>Four Innovative Solutions</h1>
    <p>Reach shoppers in store with ShopBeat, promote your offers on Specials.na, invite customers to enter competitions through Entryfy and connect with people exploring Namibia’s property market through Property News Online.</p>
  </div>
  <div class="intro-person-wrap">
    <img class="intro-person" src="/assets/Digital/FM_Brands_Digital_Intro_Personality.webp" alt="" decoding="async" fetchpriority="high">
  </div>
  <a class="scroll-cue" href={`#${brands[0].id}`}>
    <span class="scroll-arrow" aria-hidden="true"></span>
    <span>Scroll down to explore our digital brands</span>
  </a>
</section>

{brands.map(brand => (
<section class="slide brand" id={brand.id} style={`--c:${brand.color};--panel:${brand.panel}`}>
  {brand.person ? <img class="personality" alt="" decoding="async" data-src={brand.person}> : null}
  <div class="bwrap">
    <div class="bmain">
      <img class="blogo" decoding="async" src={brand.logo} alt={brand.name}>
      <p>{brand.copy}</p>
    </div>
    <div class="panel" data-offers={JSON.stringify(brand.offers)}><div class="top"><h2>Latest Offers</h2></div><div class="rows"></div></div>
  </div>
</section>
))}
</div>
</div>
<nav class="rail" aria-label="Digital brands">
  {brands.map(brand => <a href={`#${brand.id}`} style={`--c:${brand.color}`} aria-label={brand.name}></a>)}
</nav>

<Fragment slot="scripts">
<script is:inline src="/js/brands.js"></script>
</Fragment>
</Layout>
