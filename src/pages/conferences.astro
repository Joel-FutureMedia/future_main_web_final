---
import Layout from '../layouts/Layout.astro';
const slides = [
  {src: "/assets/conference/slide2.webp", alt: "PropertyNews NamProp Conference"},
  {src: "/assets/conference/slide1.webp", alt: "Future of Business"},
  {src: "/assets/conference/slide3.webp", alt: "Flight Club business breakfast"}
];
const confs = [
  ["Join us for the", "NamProp", "Conference", "16 - 17 February 2027"],
  ["Join us for the", "Future of", "Business", "2027"],
  ["Join us for", "Flight Club", "", "Invitation only"]
];
const icons = "/assets/conference_icons/FM_Conferences_Icon_";
const actions = [
  ["Become a Sponsor", "Put your brand in front of the room.", "/contact.html", `${icons}Sponsor.svg`, "icon"],
  ["Sponsor Coffee", "Host the coffee break delegates remember.", "/contact.html", `${icons}Coffee.svg`, "icon"],
  ["Buy Tickets", "Reserve your seat at the next event.", "/contact.html", `${icons}Ticket.svg`, "icon"],
  ["Newsletter Sign Up", "Conference news, straight to your inbox.", "/news.html", `${icons}Newsletter.svg`, "icon"],
  ["FAQ", "Answers on tickets, venues and timings.", "/about.html", `${icons}FAQ.svg`, "icon"],
  ["Past Events", "Highlights from previous conferences.", "/gallery.html", `${icons}Past%20Event.svg`, "icon"],
  ["Request a Proposal", "Get a package tailored to your goals.", "/contact.html", `${icons}Proposal.svg`, "icon"],
  ["Book a Table", "Bring your team or host your clients.", "/contact.html", `${icons}Booking.svg`, "icon"]
];
---
<Layout title="Conferences – FutureMedia" bodyClass="conf" preload="/assets/conference/slide2.webp">
<section class="confhero">
  <div class="conf-slider" id="slider" aria-hidden="true">
    <div class="slides">
      {slides.map((slide, index) => (
        <figure class={index === 0 ? "is-active" : undefined}>
          <img src={slide.src} alt={slide.alt} decoding="async" width="1920" height="1080">
        </figure>
      ))}
    </div>
    <div class="dots"></div>
  </div>
  <section class="hero">
    <div class="hero-copy conf-copy">
      <h1 id="ctitle">
        <span class="eyebrow" data-line="0">Join us for the</span>
        <span class="display" data-line="1">NamProp</span>
        <span class="display accent" data-line="2">Conference</span>
      </h1>
      <p class="conf-date" id="cdesc">16 - 17 February 2027</p>
    </div>
    <div class="panel" data-offers={JSON.stringify(actions)}>
      <div class="top"><h2>Join the conversation</h2></div>
      <div class="rows"></div>
    </div>
  </section>
</section>

<section class="wrap upc">
  <h2>Upcoming Events</h2>
  <div class="cards">
    <a class="card" href="/contact.html" data-bg="url(/assets/conference/slide1.webp)">
      <span class="tag">Conference</span>
      <h3>Nedbank Future of Business 2027</h3>
      <p>Namibia’s flagship business conference with keynotes, panels and networking.</p>
    </a>
    <a class="card" href="/contact.html" data-bg="url(/assets/event/event2.webp)">
      <span class="tag">Conference</span>
      <h3>PropertyNews NamProp Conference</h3>
      <p>Developers, agents, banks and conveyancers unpack Namibia’s property market.</p>
    </a>
    <a class="card" href="/contact.html" data-bg="url(/assets/event/event3.webp)">
      <span class="tag">Breakfast</span>
      <h3>Flight Club 2027</h3>
      <p>An invitation-only series where founders and decision makers trade ideas.</p>
    </a>
  </div>
</section>

<Fragment slot="scripts">
<script is:inline set:html={`window.CONFS=${JSON.stringify(confs)};`}></script>
<script is:inline src="/js/conf.js"></script>
</Fragment>
</Layout>
